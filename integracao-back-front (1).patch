+
+def test_buscar_encontrado_e_nao_encontrado():
+    local_store.inserir(METADATA_EXEMPLO)
+
+    assert local_store.buscar("v-123")["titulo"] == "Frações"
+    assert local_store.buscar("nao-existe") is None
