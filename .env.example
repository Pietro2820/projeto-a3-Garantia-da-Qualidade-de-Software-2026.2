# ==============================================================
# MODELO de variáveis de ambiente — copie para .env e preencha.
# NUNCA commite o .env (regra #6 do guia de sobrevivência Git).
# ==============================================================

# --- Supabase (banco de dados) — Pietro cria o projeto e compartilha ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Celery / Redis (fila do Pietro) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Armazenamento S3 / MinIO (João — transcodificação) ---
# ENABLE_S3=true liga o upload do original + processados após transcodificar.
# MinIO local: defina AWS_ENDPOINT_URL=http://localhost:9000.
# AWS S3 real: deixe AWS_ENDPOINT_URL comentado.
ENABLE_S3=false
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
#AWS_ENDPOINT_URL=http://localhost:9000
# Base pública de leitura do bucket — é o que o player usa para tocar os
# vídeos que moram no bucket (hls_url/thumbnail_url do catálogo).
# Formato Supabase Storage: https://<projeto>.supabase.co/storage/v1/object/public/<bucket>
# Se ficar vazia com ENABLE_S3=true, a API deriva sozinha de SUPABASE_URL + S3_BUCKET.
S3_PUBLIC_URL=

# --- Integração back ↔ front (dev sem Supabase) ---
# Banco local em JSON usado automaticamente quando SUPABASE_URL/KEY estão vazias.
#LOCAL_DB_PATH=data/videos.json
# Pasta dos vídeos transcodificados (HLS) servida pela API em /videos.
#VIDEOS_DIR=videos
# Pasta do player servida pela API em /player.
#PLAYER_DIR=player-adaptativo/player-adaptativo
